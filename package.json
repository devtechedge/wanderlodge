    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "9.39.1",
    "eslint-config-next": "15.4.9",
    "postcss": "^8.5.6",
    "tailwindcss": "4.1.11",
